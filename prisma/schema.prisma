generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["shop"]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  orders    Order[]
  @@schema("shop")
}

enum Role {
  ADMIN
  USER
  @@schema("shop")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  basePrice   Float         @default(0)
  price       Float
  discount    Float         @default(0)
  stockShop   Int           @default(0)
  stockGodown Int           @default(0)
  stock       Int           @default(0)
  sequence    Int           @default(0)
  categoryId  String
  imageUrls   String[]
  category    Category      @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  godownStock GodownStock[]
  @@schema("shop")
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  sequence Int       @default(0)
  products Product[]
  @@schema("shop")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement())
  userId          String
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  shippingAddress String
  customerPhone   String?
  transportName   String?
  trackingNumber  String?
  referredBy      String?
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   String?
  paymentDetails  String?
  createdAt       DateTime    @default(now())
  editVersion     Int         @default(1)
  lastSentVersion Int         @default(0)
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  @@schema("shop")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  @@schema("shop")
}

enum PaymentStatus {
  UNPAID
  PAID
  CREDIT
  @@schema("shop")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  @@schema("shop")
}

model Godown {
  id       String        @id @default(cuid())
  name     String
  location String?
  stocks   GodownStock[]
  @@schema("shop")
}

model GodownStock {
  id        String  @id @default(cuid())
  godownId  String
  productId String
  quantity  Int     @default(0)
  godown    Godown  @relation(fields: [godownId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([godownId, productId])
  @@schema("shop")
}

model ReferenceMaster {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  @@schema("shop")
}

model TransportMaster {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  @@schema("shop")
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  amount      Float
  category    String   @default("General") // e.g. Wages, Tea, Transport
  createdAt   DateTime @default(now())
  @@schema("shop")
}

model CustomerMaster {
  id              String   @id @default(cuid())
  primaryPhone    String   @unique
  alternatePhone  String?
  name            String
  fullAddress     String?
  city            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@schema("shop")
}
